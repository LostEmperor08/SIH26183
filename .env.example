# I4C Crypto Fraud Attribution System - Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# 1. Ethereum Mainnet (Free tier from https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 2. Polygon Network (Uses Etherscan API V2 / Polygonscan)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# 3. Tron Network for TRC-20 USDT (Free tier from https://www.trongrid.io/user/keys)
TRONGRID_API_KEY=your_trongrid_api_key_here

# Server Configuration
PORT=5000
FLASK_DEBUG=False
